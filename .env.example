POSTGRES_DB=openacts
POSTGRES_USER=openacts_projection
POSTGRES_PASSWORD=
OPENACTS_TEST_DATABASE=openacts_test
OPENACTS_API_USER=openacts_api
OPENACTS_API_PASSWORD=
OPENACTS_POSTGRES_PORT=55432
OPENACTS_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_OPENACTS_API_URL=http://127.0.0.1:8000

# Reader cache invalidation (decision 0024). Release activation purges the
# frontend's cached corpus reads through this endpoint. Leave the URL unset
# locally: activation then warns instead of failing. In a deployment both are
# required, or the reader keeps serving the previous release after activation.
OPENACTS_REVALIDATE_URL=
OPENACTS_REVALIDATE_SECRET=

# Absolute origin for canonical and Open Graph URLs. Vercel supplies its own
# production host; this overrides it.
NEXT_PUBLIC_SITE_URL=
